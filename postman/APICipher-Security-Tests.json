          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-008 | BROKEN_AUTHZ | GET /admin/users | Normal user must not reach admin endpoint\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "APC-009 Admin endpoint needs auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-009 | BROKEN_AUTHZ | GET /admin/users | Must require authentication\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rate Limiting",
      "item": [
        {
          "name": "APC-010 Login brute force",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"apc_user_a\", \"password\": \"wrong-password\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let attempts = parseInt(pm.environment.get(\"rl_attempts\")) + 1;",
                  "pm.environment.set(\"rl_attempts\", attempts);",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.environment.set(\"rl_blocked\", \"true\");",
                  "}",
                  "",
                  "if (attempts < 12) {",
                  "    postman.setNextRequest(\"APC-010 Login brute force\");",
                  "} else {",
                  "    pm.test(\"APC-010 | NO_RATE_LIMIT | POST /login | Must throttle repeated failed logins\", function () {",
                  "        pm.expect(pm.environment.get(\"rl_blocked\")).to.eql(\"true\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sensitive Data Exposure",
      "item": [
        {
          "name": "APC-011 Admin list leaks hashes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users"
