            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-011 | DATA_EXPOSURE | GET /admin/users | Admin view must not expose password hashes\", function () {",
                  "    pm.expect(pm.response.text()).to.not.include('argon2');",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security Misconfiguration",
      "item": [
        {
          "name": "APC-012 Docs exposed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
