{
  "info": {
    "name": "APICipher Security Tests",
    "description": "Automated API security test suite. Each assertion asserts SECURE behaviour, so a FAILED assertion == a detected vulnerability. Assertion names follow: ID | VULN_TYPE | ENDPOINT | Description",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Setup - Login user_a",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"apc_user_a\", \"password\": \"{{pass}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token_a\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Login user_b",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"apc_user_b\", \"password\": \"{{pass}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token_b\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"apc_admin\", \"password\": \"{{pass}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token_admin\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Capture user_b id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_b}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"user_b_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Seed user_b transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_b}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amount\": 9900, \"description\": \"user_b CONFIDENTIAL salary\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"tx_b_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "BOLA",
      "item": [
        {
          "name": "APC-001 BOLA on users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_b_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{user_b_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-001 | BOLA | GET /users/{user_id} | Must deny cross-user object access\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "APC-002 BOLA on transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/{{tx_b_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions",
                "{{tx_b_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-002 | BOLA | GET /transactions/{id} | Must deny access to another user's transaction\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});",
                  "",
                  "pm.test(\"APC-003 | BOLA | GET /transactions/{id} | Must not leak another user's transaction data\", function () {",
                  "    pm.expect(pm.response.text()).to.not.include('CONFIDENTIAL');",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Broken Authentication",
      "item": [
        {
          "name": "APC-004 Unauthenticated user list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-004 | BROKEN_AUTH | GET /users | Must require authentication\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test(\"APC-005 | BROKEN_AUTH | GET /users | Anonymous response must not contain password hashes\", function () {",
                  "    pm.expect(pm.response.text()).to.not.include('argon2');",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "APC-006 Malformed token rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.real.token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-006 | BROKEN_AUTH | GET /profile | Must reject malformed JWT\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "APC-007 Token expiry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-007 | BROKEN_AUTH | POST /login | Issued JWT must carry an exp claim\", function () {",
                  "    const parts = pm.environment.get(\"token_a\").split(\".\");",
                  "    const payload = JSON.parse(Buffer.from(parts[1], \"base64\").toString());",
                  "    pm.expect(payload).to.have.property(\"exp\");",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
