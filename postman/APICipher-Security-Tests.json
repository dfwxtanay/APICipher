          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-012 | MISCONFIG | GET /docs | Interactive API docs must not be publicly exposed\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 404]);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "APC-013 Security headers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"APC-013 | MISCONFIG | GET / | Must send X-Content-Type-Options header\", function () {",
                  "    pm.response.to.have.header('X-Content-Type-Options');",
                  "});",
                  "",
                  "pm.test(\"APC-014 | MISCONFIG | GET / | Must send X-Frame-Options header\", function () {",
                  "    pm.response.to.have.header('X-Frame-Options');",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    }
  ]
